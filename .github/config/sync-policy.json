{
    "$comment": "Sync policy for ACT-Edition pull-based fleet. Read by .github/scripts/upgrade-self.cjs in each heir. Edition-owned paths are overwritten on upgrade; heir-owned paths are preserved. All Edition-owned files live under .github/ to avoid colliding with heir project files.",
    "spec_version": "1.0",
    "edition_owned": [
        ".github/copilot-instructions.md",
        ".github/ABOUT.md",
        ".github/instructions/**",
        ".github/skills/**",
        ".github/prompts/**",
        ".github/muscles/**",
        ".github/episodic/**",
        ".github/config/sync-policy.json",
        ".github/config/markdown-light.css",
        ".github/config/README.md",
        ".github/scripts/upgrade-self.cjs",
        ".github/scripts/bootstrap-heir.cjs",
        ".github/scripts/_registry.cjs",
        ".github/VERSION",
        ".github/LICENSE"
    ],
    "heir_owned": [
        ".github/.act-heir.json",
        ".github/copilot-instructions.local.md",
        ".github/config/cognitive-config.json",
        ".github/config/goals.json",
        ".github/config/local/**",
        ".github/instructions/local/**",
        ".github/skills/local/**",
        ".github/prompts/local/**",
        ".github/muscles/local/**",
        "README.md",
        "src/**",
        "tests/**",
        "package.json",
        "package-lock.json"
    ],
    "merge_rules": {
        "edition_owned": "overwrite",
        "heir_owned": "preserve",
        "unmatched": "preserve"
    },
    "marker_fields_updated_on_sync": [
        "edition_version",
        "last_sync_at"
    ]
}
